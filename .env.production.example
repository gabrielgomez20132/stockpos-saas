# Copiar a .env en el VPS (deploy.sh lo hace la primera vez) y completar DB_*.
APP_NAME=StokPOS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://stokpos-saas.syncodeit.com.ar
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# MySQL compartido del VPS (contenedor "mysql" en la red mysql_default)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=stokpos
DB_USERNAME=stokpos
DB_PASSWORD=cambiar_password

# 12 horas: un corte de internet largo no obliga a volver a entrar
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@syncodeit.com.ar"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
INERTIA_DEVTOOLS_ENABLED=false
